# FortyGuard (server-side only)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Production CrewClock route. Secrets remain local and server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=qwen/qwen3.8-max-free

LLM_PRIMARY_PROVIDER=groq
LLM_SECONDARY_PROVIDER=tokenrouter
LLM_INTERACTIVE_TIMEOUT_MS=8000
LLM_MAX_INTERACTIVE_TOTAL_MS=15000
LLM_MAX_INTERACTIVE_MODEL_TURNS=3
